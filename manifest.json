{
  "manifest_version": 3,
  "name": "Mathlete Daily Coach",
  "short_name": "Mathlete Coach",
  "version": "1.2.0",
  "description": "Daily math-competition practice that adapts to your child, explains every mistake, and keeps the browser locked until it is done.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Mathlete Daily Coach"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "incognito": "spanning",
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "app.css",
        "lib/blocking.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}

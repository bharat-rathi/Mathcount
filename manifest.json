{
  "manifest_version": 3,
  "name": "MATHCOUNTS Daily Coach",
  "short_name": "Math Coach",
  "version": "1.0.0",
  "description": "Daily adaptive MATHCOUNTS practice with streaks and badges. Locks the browser until practice is done.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "MATHCOUNTS Daily Coach" },
  "background": { "service_worker": "background.js", "type": "module" },
  "chrome_url_overrides": { "newtab": "app.html" },
  "permissions": ["storage", "declarativeNetRequest", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "incognito": "spanning",
  "web_accessible_resources": [{ "resources": ["blocked.html", "blocked.js", "app.css"], "matches": ["<all_urls>"] }]
}
